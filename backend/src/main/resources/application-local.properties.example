# Copy this file to application-local.properties (same folder) and fill in your values.
# application-local.properties is git-ignored: never commit real passwords or secrets.

spring.datasource.url=jdbc:postgresql://localhost:5432/itsm
spring.datasource.username=postgres
spring.datasource.password=CHANGE_ME

# Any random string of AT LEAST 32 characters. All teammates can use different ones.
app.jwt.secret=CHANGE_ME_to_a_random_string_of_at_least_32_chars


# --- Optional: AI category suggestion (Google Gemini). Without a key, keyword suggestions are used. ---
# app.ai.gemini.api-key=
# app.ai.gemini.model=gemini-3.8-flash
# app.ai.gemini.fallback-models=
# app.ai.timeout-ms=4000

# --- Optional: real email (e.g. Mailtrap sandbox). Without spring.mail.host, emails are printed to the console. ---
# spring.mail.host=sandbox.smtp.mailtrap.io
# spring.mail.port=2525
# spring.mail.username=
# spring.mail.password=
# spring.mail.properties.mail.smtp.auth=true
# spring.mail.properties.mail.smtp.starttls.enable=true
# app.mail.from=I-ITSM Service Desk <no-reply@itsm.local>
